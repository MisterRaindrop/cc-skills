# Copy to ~/.tpc-bench/site.env and fill in. Nothing site-specific lives in the skill itself.
TPCBENCH_SSH_KEY=/root/.ssh/id_rsa                       # key used to ssh (as root) to the test hosts
TPCBENCH_REPORT_SSH=user@report-host                     # proteus report server (scp target for report files)
TPCBENCH_REPORT_WEB=http://report-host:5000/p_report     # report page URL prefix (<prefix>/<report_id>)
TPCBENCH_REPORT_DIR=/proteus/perf                        # report files dir on the report server
TPCBENCH_REPORT_DB=host=report-host port=5432 dbname=new user=tpcds   # libpq conninfo of the report DB (metric curves)
TPCBENCH_GITLAB_HOST=gitlab.example.com                  # GitLab of the umbrella CI (glab must be logged in)
TPCBENCH_UMBRELLA_PROJECT=group/subgroup/umbrella        # umbrella project path (pipelines + RPM artifacts)
TPCBENCH_PROTEUS_GIT=git@gitlab.example.com:group/proteus.git
TPCBENCH_UMBRELLA_DIR=/path/to/umbrella/checkout         # local umbrella repo (git log / diff for report 3)
TPCBENCH_VAULT_DIR=Knowledge/Projects/<project>/perf-reports   # claude-sync vault dir for the reports
